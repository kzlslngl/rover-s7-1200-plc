FUNCTION_BLOCK "FB_ActiveConfigManager"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      Configured : Bool;
      CommandTimeoutValid : Bool;
      G16TimeoutsValid : Bool;
      MotionLimitsValid : Bool;
      ControlledStopProfileValid : Bool;
      G16CalibrationValid : Bool;
      VehicleGeometryValid : Bool;
      FeedbackUnitsValid : Bool;
      G16LossPolicyValid : Bool;
      ConfigVersion : DWord;
      ConfigCrc32 : DWord;
      G16LossPolicy : UInt;
      CommandTimeoutMs : DWord;
      OrinHeartbeatTimeoutMs : DWord;
      G16FrameTimeoutMs : DWord;
      G16GatewayTimeoutMs : DWord;
      ControlledStopTimeoutMs : DWord;
      ManualNeutralHoldMs : DWord;
      AutoG16GraceMs : DWord;
      MaxForwardSpeedMps : Real;
      MaxReverseSpeedMps : Real;
      MaxSteeringAngleRad : Real;
      MaxAccelerationMps2 : Real;
      MaxDecelerationMps2 : Real;
      MaxSteeringRateRadps : Real;
      ControlledStopDecelerationMps2 : Real;
      WheelbaseM : Real;
      G16CalibrationVersion : DWord;
      G16CalibrationCrc32 : DWord;
      BrakeEffectUnit : UInt;
   END_VAR
   VAR_OUTPUT
      Model : "UDT_ActiveConfigModel";
   END_VAR
   VAR_TEMP
      Flags : Word;
   END_VAR

BEGIN
   #Flags := 16#0000;
   IF #Configured THEN #Flags := #Flags OR 16#0001; END_IF;
   IF #CommandTimeoutValid THEN #Flags := #Flags OR 16#0002; END_IF;
   IF #G16TimeoutsValid THEN #Flags := #Flags OR 16#0004; END_IF;
   IF #MotionLimitsValid THEN #Flags := #Flags OR 16#0008; END_IF;
   IF #ControlledStopProfileValid THEN #Flags := #Flags OR 16#0010; END_IF;
   IF #G16CalibrationValid THEN #Flags := #Flags OR 16#0020; END_IF;
   IF #VehicleGeometryValid THEN #Flags := #Flags OR 16#0040; END_IF;
   IF #FeedbackUnitsValid THEN #Flags := #Flags OR 16#0080; END_IF;
   IF #G16LossPolicyValid THEN #Flags := #Flags OR 16#0100; END_IF;

   #Model.ConfigVersion := #ConfigVersion;
   #Model.ConfigCrc32 := #ConfigCrc32;
   #Model.ConfigFlags := #Flags;
   #Model.G16LossPolicy := #G16LossPolicy;
   #Model.CommandTimeoutMs := #CommandTimeoutMs;
   #Model.OrinHeartbeatTimeoutMs := #OrinHeartbeatTimeoutMs;
   #Model.G16FrameTimeoutMs := #G16FrameTimeoutMs;
   #Model.G16GatewayTimeoutMs := #G16GatewayTimeoutMs;
   #Model.ControlledStopTimeoutMs := #ControlledStopTimeoutMs;
   #Model.ManualNeutralHoldMs := #ManualNeutralHoldMs;
   #Model.AutoG16GraceMs := #AutoG16GraceMs;
   #Model.MaxForwardSpeedMps := #MaxForwardSpeedMps;
   #Model.MaxReverseSpeedMps := #MaxReverseSpeedMps;
   #Model.MaxSteeringAngleRad := #MaxSteeringAngleRad;
   #Model.MaxAccelerationMps2 := #MaxAccelerationMps2;
   #Model.MaxDecelerationMps2 := #MaxDecelerationMps2;
   #Model.MaxSteeringRateRadps := #MaxSteeringRateRadps;
   #Model.ControlledStopDecelerationMps2 := #ControlledStopDecelerationMps2;
   #Model.WheelbaseM := #WheelbaseM;
   #Model.G16CalibrationVersion := #G16CalibrationVersion;
   #Model.G16CalibrationCrc32 := #G16CalibrationCrc32;
   #Model.BrakeEffectUnit := #BrakeEffectUnit;
END_FUNCTION_BLOCK
